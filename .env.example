APP_NAME="Sistem Raport Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Comma-separated proxy IPs/CIDRs. For a private Cloudflare Tunnel origin whose
# proxy address changes, use * only when the origin cannot be reached directly.
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Base URL for files on the "public" disk. Leave empty to serve them relative to
# the current host (recommended). Only set this when uploads live on a separate
# domain or CDN, e.g. https://cdn.example.com
FILESYSTEM_PUBLIC_URL=
# Keep empty unless static assets are intentionally served from a separate CDN.
ASSET_URL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ABSENSI_API_URL=https://absensilantaburo.my.id/api/v1/gurus
ABSENSI_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile — Production wajib pakai key asli, jangan pakai test key 1x000...
# Test banner merah "Hanya untuk pengujian" adalah normal di local jika pakai test key, jangan hide via JS/CSS
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_THEME=auto
TURNSTILE_SIZE=flexible
TURNSTILE_LANGUAGE=id
